# Copia este fichero a `.env` (ignorado por git) y rellena los valores.
# Tambien valen como variables de entorno; estas siempre ganan al .env.

# Token del panel. Si lo defines, toda la API y el video lo exigen.
# Sin token, Vigia solo atiende a 127.0.0.1 y se niega a escuchar en red.
VIGIA_TOKEN=

# Bot de Telegram. Crear con @BotFather y hablarle una vez al bot para que
# aparezca el chat_id; el bot solo atendera a ese chat.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Host/puerto opcionales (ganan a config.yaml).
# VIGIA_HOST=127.0.0.1
# VIGIA_PUERTO=8000
